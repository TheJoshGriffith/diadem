# Copy to .env beside docker-compose.yml and fill in. Never commit .env.

# Must be lowercase: Docker rejects uppercase repository names, and GHCR
# normalises your username on publish regardless of how you type it.
GHCR_OWNER=your-github-username

# Database. Defaults assume everything shares the `pogo` Docker network, so
# container names resolve. If it doesn't, point these at the host instead:
#   DB_HOST=10.0.0.20
#   DB_PORT=3369
DB_HOST=mariadb
DB_PORT=3306
SCANNER_DB_NAME=golbat

# Scanner services. Same story - names work on the shared network, otherwise
# use http://10.0.0.20:<published port>
GOLBAT_URL=http://golbat:9001
DRAGONITE_URL=http://dragonite:7272
KOJI_URL=http://koji:8080
KOJI_PROJECT=reactmap

# From deploy/bootstrap-db.sh
DIADEM_INTERNAL_DB_PASSWORD=
DIADEM_SCANNER_DB_PASSWORD=

# From your existing golbat / dragonite / koji configs
GOLBAT_SECRET=
DRAGONITE_SECRET=
KOJI_SECRET=

# Discord OAuth application. Redirect URI must match PUBLIC_URL below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public address NPM serves this on, no trailing slash. ORIGIN must match how
# the browser actually reaches the app - if you are testing on the LAN before
# NPM is wired up, set it to http://10.0.0.20:3962 or POSTs will 403.
PUBLIC_URL=https://map.example.com
ORIGIN=https://map.example.com

MAP_NAME=Diadem

# Host port for direct access. Use 127.0.0.1:3900 to keep it off the LAN
# once NPM is doing the serving.
HOST_PORT=3900

# Set AUTH_ENABLED=false to run without Discord login; the two vars above
# can then stay blank. LOG_LEVEL: error|warning|info|debug
AUTH_ENABLED=true
AUTH_OPTIONAL=true
LOG_LEVEL=info
